 "description": "A member of staff asks to be paid into a new bank account or mobile number; HR checks and confirms it before any payment uses it.",
 "doctype": "DocType",
 "documentation": "https://docs.stelden.com/hrms/self-service/payout-change-request",
 "engine": "InnoDB",
 "field_order": [
  "naming_series",
  "employee",
  "employee_name",
  "company",
  "cb1",
  "status",
  "change",
  "sb1",
  "bank",
  "bank_account_no",
  "branch_code",
  "account_name",
